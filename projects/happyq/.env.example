# Target environment URL
BASE_URL=http://localhost:5173

# Slack webhook for test result notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Test user credentials — matched by key names in TEST_USERS Excel sheet
TEST_USER_STANDARD_EMAIL=standard@test.happyq.com
TEST_USER_STANDARD_PASSWORD=

TEST_USER_FRONT_DESK_EMAIL=frontdesk@test.happyq.com
TEST_USER_FRONT_DESK_PASSWORD=

TEST_USER_CLINICIAN_EMAIL=clinician@test.happyq.com
TEST_USER_CLINICIAN_PASSWORD=

TEST_USER_BILLING_EMAIL=billing@test.happyq.com
TEST_USER_BILLING_PASSWORD=

# Supabase connection — used ONLY for cleanup (CLEANUP=true)
# Point this at your TEST/STAGING instance only — NEVER production
SUPABASE_URL=https://your-test-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Set to 'true' to delete all ADAPT-tagged data from previous runs before starting
# Run IDs are tagged as [ADAPT-YYYYMMDD-HHmm] on all created records
CLEANUP=false

# Environment label written to the RESULTS sheet (local | staging | production)
ENV=local
